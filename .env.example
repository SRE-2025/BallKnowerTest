# =============================================================================
# BallKnower — Environment Variables
# =============================================================================
# Phase 1 runs entirely on mock data and needs NONE of these to start.
# They are documented now so later phases can be wired in without surprises.
# Copy this file to `.env` and fill in real values only when a phase needs them.
# NEVER commit your real `.env` file.
# =============================================================================

# ---- App ----
NEXT_PUBLIC_APP_NAME="BallKnower"
# Toggles the data source. "mock" (Phase 1) or "database" (Phase 2+).
DATA_SOURCE="mock"

# ---- Database (Phase 2+) -----------------------------------------------------
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ballknower?schema=public"

# ---- Claude API — AI Producer (Phase 3) -------------------------------------
ANTHROPIC_API_KEY=""
# Recommended model for the in-app AI producer.
ANTHROPIC_MODEL="claude-opus-4-8"

# ---- Highlight discovery & media acquisition --------------------------------
# YouTube Data API v3 key — enables live discovery from YouTube / official
# league channels. Without it, discovery falls back to the curated seed set.
YOUTUBE_API_KEY=""
# Gate for downloading actual media bytes via yt-dlp. Discovery/metadata is
# always allowed; set this to "true" ONLY if you hold the rights to download and
# repost the media. Requires `yt-dlp` on PATH (pip install yt-dlp).
ALLOW_MEDIA_DOWNLOAD="false"

# ---- Object Storage — clips, uploads, renders (Phase 2 / 5) -----------------
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---- Transcription (Phase 2) ------------------------------------------------
# Recommended: Deepgram or AssemblyAI for cost/quality on sports audio.
TRANSCRIPTION_PROVIDER="deepgram"
TRANSCRIPTION_API_KEY=""

# ---- Background jobs / queue (Phase 2+) -------------------------------------
# Recommended: a hosted Redis (Upstash) + BullMQ, or Inngest for serverless.
REDIS_URL=""

# ---- Auth (post Phase 1) ----------------------------------------------------
# Recommended: NextAuth (Auth.js).
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ---- Social posting (Phase 7) -----------------------------------------------
# Each platform uses its real publish API when its token is present, else the
# mock provider. Most platforms PULL the video from a public URL, so set
# PUBLIC_BASE_URL (or host renders on S3) for real posting of local drafts.
PUBLIC_BASE_URL=""

YOUTUBE_ACCESS_TOKEN=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

TIKTOK_ACCESS_TOKEN=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_USER_ID=""
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""

FACEBOOK_ACCESS_TOKEN=""
FACEBOOK_PAGE_ID=""

X_ACCESS_TOKEN=""
