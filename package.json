{
  "name": "ballknower",
  "version": "0.1.0",
  "private": true,
  "description": "Automated, creator-led daily sports content production platform.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "setup": "bash scripts/setup.sh",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:push": "prisma db push --skip-generate",
    "db:reset": "prisma db push --force-reset --skip-generate && npm run prisma:seed",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "pipeline": "tsx scripts/run-pipeline.ts",
    "highlights": "tsx scripts/pull-highlights.ts",
    "generate": "tsx scripts/generate-package.ts",
    "render": "tsx scripts/render-package.ts",
    "post": "tsx scripts/post-package.ts",
    "scheduler": "tsx scripts/run-scheduler.ts",
    "analytics": "tsx scripts/import-analytics.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@prisma/client": "^5.22.0",
    "clsx": "^2.1.1",
    "fluent-ffmpeg": "^2.1.3",
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rss-parser": "^3.13.0",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "^8.4.39",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
